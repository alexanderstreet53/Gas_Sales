# See apps/web/.env.example and apps/worker/.env.example for the
# component-level env files. This root file lists every variable the
# platform reads, in one place.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New-style keys (preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy names (still accepted as fallbacks):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Google Maps Platform ----
GOOGLE_MAPS_API_KEY=AIza...
# Pricing (USD per 1000 requests) used by lib/imagery/cost.ts
GOOGLE_STATIC_MAPS_COST_PER_1K=2.00
GOOGLE_STREETVIEW_COST_PER_1K=7.00
GOOGLE_GEOCODING_COST_PER_1K=5.00
GOOGLE_PLACES_COST_PER_1K=17.00

# ---- Mapbox (display only) ----
NEXT_PUBLIC_MAPBOX_TOKEN=pk.ey...

# ---- Imagery cache + rate limits ----
IMAGERY_TTL_DAYS=90
IMAGERY_QPS=10
IMAGERY_DAILY_CAP_USD=25
IMAGERY_DEFAULT_ZOOM=19

# ---- ML worker ----
WORKER_URL=http://localhost:8000
WORKER_API_KEY=change-me-shared-secret

# ---- Optional enrichment ----
COMPANIES_HOUSE_API_KEY=
